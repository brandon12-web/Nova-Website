---
const faqs = [
  {
    q: "Who is eligible to compete?",
    a: "Any high school student in Ontario, grades 9 through 12. You compete in teams of four — no prior case-competition experience required.",
  },
  {
    q: "How much does it cost to enter?",
    a: "Registration details and any fees will be confirmed in your application. Our goal is to keep Nova as accessible as possible for all students.",
  },
  {
    q: "What does the competition day look like?",
    a: "Nova runs over two rounds. In each round your team gets a real business case, then 90 minutes to prepare, 10 minutes to present to a panel of judges, and a 3-minute Q&A.",
  },
  {
    q: "Do we need a teacher or advisor to apply?",
    a: "You don't need an advisor to compete, but teachers are welcome to support and encourage teams. Just gather four students and submit your application before September 10, 2026.",
  },
  {
    q: "When will we know if we've been selected?",
    a: "Finalists will be announced after applications close on September 10. Keep an eye on your inbox — we'll notify selected teams with all the details.",
  },
];
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container faq">
    <div class="reveal">
      <span class="section__eyebrow">Good to know</span>
      <h2 class="section__title" id="faq-title">Frequently asked questions</h2>
    </div>

    <div class="faq__list reveal">
      {faqs.map((item, i) => (
        <details class="faq__item" name="faq" open={i === 0}>
          <summary class="faq__q">
            <span>{item.q}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__a"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { max-width: 780px; }
  .faq__list { margin-top: clamp(1.5rem, 4vw, 2.5rem); display: grid; gap: 0.75rem; }
  .faq__item {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: border-color 0.25s var(--ease);
  }
  .faq__item[open] { border-color: rgba(43, 110, 150, 0.5); }
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    cursor: pointer;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.08rem;
    color: #fff;
    list-style: none;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 18px; height: 18px;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    background: var(--steel-bright);
    border-radius: 2px;
    transition: transform 0.25s var(--ease), opacity 0.25s var(--ease);
  }
  .faq__icon::before { top: 8px; left: 0; width: 18px; height: 2px; }
  .faq__icon::after { top: 0; left: 8px; width: 2px; height: 18px; }
  .faq__item[open] .faq__icon::after { transform: scaleY(0); opacity: 0; }
  .faq__item[open] .faq__icon::before { background: var(--gold); }

  .faq__a {
    padding: 0 1.25rem 1.2rem;
    color: var(--muted);
  }
  .faq__a p { margin: 0; }
</style>
