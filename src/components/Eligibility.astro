---
const points = [
  { icon: "◈", title: "All of Ontario", desc: "Open to every high school student across the province." },
  { icon: "◈", title: "Grades 9–12", desc: "Any grade, any experience level — no prior competition needed." },
  { icon: "◈", title: "Teams of 4", desc: "Assemble a squad of four students to compete together." },
];
---

<section class="section eligibility" id="eligibility" aria-labelledby="elig-title">
  <div class="container">
    <div class="eligibility__card card reveal">
      <div class="eligibility__intro">
        <span class="section__eyebrow">Who can enter</span>
        <h2 class="section__title" id="elig-title">Eligibility</h2>
        <p class="section__lead">
          Nova is open to <strong>all high school students in Ontario</strong>.
          Grab three teammates and put your name in.
        </p>
      </div>
      <ul class="eligibility__list">
        {points.map((p) => (
          <li class="eligibility__item">
            <span class="eligibility__icon" aria-hidden="true">{p.icon}</span>
            <div>
              <h3 class="eligibility__item-title">{p.title}</h3>
              <p class="eligibility__item-desc">{p.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .eligibility__card {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    padding: clamp(1.75rem, 5vw, 3rem);
    background:
      radial-gradient(120% 100% at 100% 0%, rgba(43, 110, 150, 0.12), transparent 60%),
      var(--bg-elev);
  }
  .eligibility__list {
    display: grid;
    gap: 1.25rem;
  }
  .eligibility__item {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .eligibility__icon {
    color: var(--steel-bright);
    font-size: 1.4rem;
    line-height: 1.2;
    flex-shrink: 0;
  }
  .eligibility__item-title { font-size: 1.15rem; margin-bottom: 0.15rem; }
  .eligibility__item-desc { color: var(--muted); margin: 0; font-size: 0.96rem; }

  @media (min-width: 820px) {
    .eligibility__card { grid-template-columns: 1fr 1.1fr; align-items: center; }
    .eligibility__list { grid-template-columns: 1fr; }
  }
</style>
