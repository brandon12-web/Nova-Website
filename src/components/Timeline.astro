---
const events = [
  {
    date: "Now open",
    title: "Applications open",
    desc: "Team registration is live. Get your squad of four together and apply.",
    state: "active",
  },
  {
    date: "September 10, 2026",
    title: "Applications close",
    desc: "Final deadline to submit your team's application. No late entries.",
    state: "key",
  },
  {
    date: "Coming soon",
    title: "Finalists announced",
    desc: "Selected teams are notified and invited to compete on the big day.",
    state: "",
  },
  {
    date: "November 14, 2026",
    title: "Competition day",
    desc: "Two rounds, live judging, and the crowning of Nova's rising stars.",
    state: "key",
  },
];
---

<section class="section" id="timeline" aria-labelledby="timeline-title">
  <div class="container">
    <div class="reveal">
      <span class="section__eyebrow">The road to November</span>
      <h2 class="section__title" id="timeline-title">Timeline</h2>
      <p class="section__lead">Key milestones on the way to competition day.</p>
    </div>

    <ol class="timeline reveal" aria-label="Competition timeline">
      {events.map((e) => (
        <li class={`timeline__item ${e.state === "key" ? "is-key" : ""} ${e.state === "active" ? "is-active" : ""}`}>
          <span class="timeline__dot" aria-hidden="true"></span>
          <div class="timeline__content card">
            <span class="timeline__date">{e.date}</span>
            <h3 class="timeline__title">{e.title}</h3>
            <p class="timeline__desc">{e.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    margin-top: clamp(2rem, 5vw, 3rem);
    padding-left: 2rem;
  }
  /* the vertical comet trail */
  .timeline::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--steel) 0%,
      rgba(43, 110, 150, 0.4) 50%,
      var(--gold) 100%
    );
    border-radius: 2px;
  }
  .timeline__item {
    position: relative;
    padding-bottom: 1.5rem;
  }
  .timeline__item:last-child { padding-bottom: 0; }
  .timeline__dot {
    position: absolute;
    left: -2rem;
    top: 1.4rem;
    width: 16px; height: 16px;
    border-radius: 50%;
    background: var(--bg-elev-2);
    border: 2px solid var(--steel);
    transform: translateX(-1px);
  }
  .timeline__item.is-active .timeline__dot {
    background: var(--steel-bright);
    box-shadow: 0 0 0 5px rgba(43, 110, 150, 0.22);
  }
  .timeline__item.is-key .timeline__dot {
    background: var(--gold);
    border-color: var(--gold);
    box-shadow: 0 0 0 5px rgba(198, 162, 74, 0.2);
  }
  .timeline__date {
    display: inline-block;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--steel-bright);
    margin-bottom: 0.35rem;
  }
  .timeline__item.is-key .timeline__date { color: var(--gold); }
  .timeline__title { font-size: 1.25rem; margin-bottom: 0.3rem; }
  .timeline__desc { color: var(--muted); margin: 0; font-size: 0.96rem; }

  @media (min-width: 820px) {
    .timeline { padding-left: 0; margin-inline: auto; max-width: 900px; }
    .timeline::before { left: 50%; transform: translateX(-50%); }
    .timeline__item {
      width: 50%;
      padding-bottom: 2rem;
    }
    .timeline__item:nth-child(odd) {
      left: 0;
      padding-right: 2.5rem;
      text-align: right;
    }
    .timeline__item:nth-child(even) {
      left: 50%;
      padding-left: 2.5rem;
    }
    .timeline__item:nth-child(odd) .timeline__dot { left: auto; right: -8px; }
    .timeline__item:nth-child(even) .timeline__dot { left: -8px; }
  }
</style>
