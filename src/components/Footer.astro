---
const year = new Date().getFullYear();
const email = "hello@novacompetition.ca";
const socials = [
  { label: "Instagram", href: "https://instagram.com/", handle: "@novacompetition" },
  { label: "LinkedIn", href: "https://linkedin.com/", handle: "Nova Competition" },
  { label: "TikTok", href: "https://tiktok.com/", handle: "@novacompetition" },
];
---

<footer class="footer" aria-labelledby="footer-title">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a class="footer__logo-link" href="#top" aria-label="Nova — back to top">
        <img src="/nova-logo.png" alt="Nova starburst logo" width="44" height="44" />
        <span class="footer__wordmark">Nova</span>
      </a>
      <p class="footer__tag">Real cases. Real pressure. Rising stars.</p>
      <p class="footer__mini">Ontario's high school business case competition.</p>
    </div>

    <div class="footer__col">
      <h2 class="footer__title" id="footer-title">Get in touch</h2>
      <a class="footer__email" href={`mailto:${email}`}>{email}</a>
      <a class="btn btn--primary footer__cta" href="#apply">Apply Now</a>
    </div>

    <div class="footer__col">
      <h2 class="footer__title">Follow along</h2>
      <ul class="footer__socials">
        {socials.map((s) => (
          <li>
            <a href={s.href} rel="noopener noreferrer" target="_blank">
              <span class="footer__social-label">{s.label}</span>
              <span class="footer__social-handle">{s.handle}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <hr class="comet-divider footer__divider" />

  <div class="container footer__bottom">
    <p>&copy; {year} Nova Competition. All rights reserved.</p>
    <p class="footer__note">Key dates: Applications close Sept 10, 2026 &middot; Competition Nov 14, 2026</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-top: clamp(2.5rem, 6vw, 4rem);
    background: linear-gradient(to bottom, transparent, rgba(43, 110, 150, 0.05));
  }
  .footer__inner {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }
  .footer__logo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #fff;
  }
  .footer__logo-link:hover { color: #fff; }
  .footer__wordmark {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.4rem;
  }
  .footer__tag {
    font-family: var(--font-head);
    color: var(--steel-bright);
    margin: 0.75rem 0 0.25rem;
    font-size: 1rem;
  }
  .footer__mini { color: var(--muted); font-size: 0.9rem; margin: 0; }

  .footer__title {
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.9rem;
    font-family: var(--font-body);
    font-weight: 600;
  }
  .footer__email {
    display: inline-block;
    font-family: var(--font-head);
    font-size: 1.1rem;
    color: #fff;
    margin-bottom: 1rem;
  }
  .footer__email:hover { color: var(--gold); }
  .footer__cta { display: inline-flex; padding: 0.7rem 1.3rem; }

  .footer__socials { display: grid; gap: 0.75rem; }
  .footer__socials a { display: flex; flex-direction: column; }
  .footer__social-label { color: #fff; font-weight: 500; }
  .footer__social-label:hover,
  .footer__socials a:hover .footer__social-label { color: var(--gold); }
  .footer__social-handle { color: var(--muted); font-size: 0.85rem; }

  .footer__divider { margin-top: clamp(2.5rem, 6vw, 4rem); }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    padding-block: 1.5rem 2rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .footer__bottom p { margin: 0; }

  @media (min-width: 760px) {
    .footer__inner { grid-template-columns: 1.4fr 1fr 1fr; }
  }
</style>
