---
import { site } from "../../config/template";
const { footer } = site;
const year = new Date().getFullYear();
---
<footer class="t-footer">
  <div class="t-container">
    <div class="t-footer__grid">
      <div>
        <img class="t-footer__logo" src="/nova-logo-light.png" alt={`${site.eventName} logo`} width="855" height="736" />
        <p>{footer.blurb}</p>
      </div>

      <div>
        <h4>Event</h4>
        <ul class="t-footer__list">
          <li>{site.date}</li>
          <li>{site.location}</li>
          <li>{site.audience}</li>
        </ul>
      </div>

      <div>
        <h4>Connect</h4>
        <ul class="t-footer__list">
          {footer.socials.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="t-footer__bottom">
      © {year} {site.eventName}. All rights reserved.
    </div>
  </div>
</footer>
