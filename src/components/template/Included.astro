---
import { site } from "../../config/template";
const { included } = site;

// Simple inline icon set keyed by the `icon` field in the config.
const icons: Record<string, string> = {
  prep: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>',
  workshop: '<path d="M14.7 6.3a5 5 0 0 0-6.4 6.4L3 18l3 3 5.3-5.3a5 5 0 0 0 6.4-6.4l-2.8 2.8-2.1-2.1 2.9-2.7z"/>',
  case: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
  network: '<circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="19" r="2.5"/><circle cx="19" cy="19" r="2.5"/><path d="M12 7.5v4M12 11.5 6.5 17M12 11.5 17.5 17"/>',
  food: '<path d="M3 2v7a3 3 0 0 0 6 0V2M6 2v20M16 2c-2 0-3 2-3 5s1 5 3 5 3-2 3-5V2z"/><path d="M19 12v10"/>',
  swag: '<path d="M20.4 14.5 16 10 4 22"/><path d="m16 8-1.5-1.5a2.1 2.1 0 0 0-3 0L2 15l5 5 8-8"/><circle cx="17.5" cy="6.5" r="3.5"/>',
};
---
<section class="t-section t-section--alt" id="included">
  <div class="t-container">
    <div class="t-center t-reveal">
      <span class="t-eyebrow">{included.eyebrow}</span>
      <h2 class="t-title">{included.title}</h2>
      <p class="t-lead">{included.lead}</p>
    </div>

    <div class="t-grid t-grid--3" style="margin-top:2.5rem">
      {included.items.map((item) => (
        <article class="t-card t-feature t-reveal">
          <div class="t-feature__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon] ?? icons.case} />
          </div>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
