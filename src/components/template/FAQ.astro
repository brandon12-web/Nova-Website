---
import { site } from "../../config/template";
const { faq } = site;
---
<section class="t-section" id="faq">
  <div class="t-container">
    <div class="t-center t-reveal">
      <span class="t-eyebrow">{faq.eyebrow}</span>
      <h2 class="t-title">{faq.title}</h2>
    </div>

    <div class="t-faq t-reveal">
      {faq.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
