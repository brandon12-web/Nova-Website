---
import { site } from "../../config/template";
---
<section class="t-hero" id="top">
  <div class="t-container t-hero__inner">
    <div class="t-hero__content">
      <h1>{site.eventName}</h1>
      <p class="t-hero__tagline">{site.tagline}</p>
      <p class="t-hero__blurb">{site.heroBlurb}</p>

      <div class="t-hero__facts">
        <span class="t-hero__fact">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          {site.date}
        </span>
        <span class="t-hero__fact">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
          {site.location}
        </span>
        <span class="t-hero__fact">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9.5" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/></svg>
          {site.audience}
        </span>
      </div>

      <div class="t-hero__actions">
        <a class="t-btn t-btn--primary" href={site.ctaHref}>{site.ctaLabel}</a>
        <a class="t-btn t-btn--ghost" href="#about">Learn more</a>
      </div>
    </div>

    <!-- Branded starburst — echoes the Nova logo mark -->
    <div class="t-hero__visual" aria-hidden="true">
      <svg viewBox="0 0 400 400" class="t-hero__star">
        <defs>
          <radialGradient id="novaGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#00D4FF" stop-opacity="0.35" />
            <stop offset="55%" stop-color="#00D4FF" stop-opacity="0.08" />
            <stop offset="100%" stop-color="#00D4FF" stop-opacity="0" />
          </radialGradient>
        </defs>
        <circle cx="200" cy="200" r="185" fill="url(#novaGlow)" />
        <!-- main navy 4-point star -->
        <path d="M200 50 C200 140 140 200 50 200 C140 200 200 260 200 350 C200 260 260 200 350 200 C260 200 200 140 200 50 Z" fill="var(--brand)" />
        <!-- cyan diagonal star, rotated 45° -> 8-point burst -->
        <path d="M200 105 C200 160 160 200 105 200 C160 200 200 240 200 295 C200 240 240 200 295 200 C240 200 200 160 200 105 Z" transform="rotate(45 200 200)" fill="var(--cyan)" />
        <circle cx="200" cy="200" r="24" fill="#fff" opacity="0.9" />
        <!-- scattered sparkles -->
        <path d="M330 70 C330 84 316 98 302 98 316 98 330 112 330 126 330 112 344 98 358 98 344 98 330 84 330 70 Z" fill="var(--cyan)" opacity="0.85" />
        <path d="M70 300 C70 312 58 324 46 324 58 324 70 336 70 348 70 336 82 324 94 324 82 324 70 312 70 300 Z" fill="var(--brand)" opacity="0.7" />
        <circle cx="96" cy="120" r="5" fill="var(--accent)" />
        <circle cx="320" cy="300" r="6" fill="var(--accent)" opacity="0.8" />
      </svg>
    </div>
  </div>
</section>
