---
import Starfield from "./Starfield.astro";
import Countdown from "./Countdown.astro";

// Application deadline — Sept 10, 2026, 11:59 PM Eastern (EDT = UTC-4).
const DEADLINE = "2026-09-10T23:59:00-04:00";
---

<section class="hero" aria-labelledby="hero-title">
  <Starfield />

  <div class="hero__inner container">
    <h1 class="hero__title" id="hero-title">
      <img
        class="hero__logo"
        src="/nova-logo.png"
        alt="Nova"
        width="440"
        height="304"
        fetchpriority="high"
      />
    </h1>
    <p class="hero__tagline">Real cases. Real pressure. Rising stars.</p>
    <p class="hero__sub">
      Ontario's high school business case competition. Open to every
      student, grades 9&ndash;12.
    </p>

    <ul class="hero__dates">
      <li>
        <span class="hero__dates-label">Applications close</span>
        <span class="hero__dates-value">September 10, 2026</span>
      </li>
      <li aria-hidden="true" class="hero__dates-div"></li>
      <li>
        <span class="hero__dates-label">Competition day</span>
        <span class="hero__dates-value">November 14, 2026</span>
      </li>
    </ul>

    <div class="hero__countdown">
      <Countdown deadline={DEADLINE} />
    </div>

    <div class="hero__cta">
      <a class="btn btn--primary" href="#apply">Apply Now</a>
      <a class="btn btn--ghost" href="#about">Learn more</a>
    </div>
  </div>

  <div class="hero__fade" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 9vw, 6rem);
    min-height: min(92vh, 900px);
    display: flex;
    align-items: center;
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  /* The logo is a full wordmark (it already contains "Nova"),
     so it carries the title on its own. */
  .hero__title {
    margin: 0 0 0.4rem;
    line-height: 0;
  }
  .hero__logo {
    width: min(440px, 82vw);
    height: auto;
    filter: drop-shadow(0 0 34px rgba(43, 110, 150, 0.55));
    animation: floaty 6s ease-in-out infinite;
  }
  @keyframes floaty {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-9px); }
  }
  .hero__tagline {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: clamp(1.15rem, 3.6vw, 1.7rem);
    color: var(--steel-bright);
    margin: 0.2rem 0 0.6rem;
  }
  .hero__sub {
    color: var(--muted);
    max-width: 46ch;
    margin: 0 auto 1.75rem;
    font-size: 1.05rem;
  }

  .hero__dates {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.75rem;
  }
  .hero__dates li:not(.hero__dates-div) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .hero__dates-label {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .hero__dates-value {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.15rem;
    color: #fff;
  }
  .hero__dates-div {
    width: 1px;
    height: 34px;
    background: var(--border);
  }

  .hero__countdown {
    width: 100%;
    max-width: 480px;
    margin-bottom: 1.9rem;
  }

  .hero__cta {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* soft fade into the next section */
  .hero__fade {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 120px;
    z-index: 1;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  @media (max-width: 420px) {
    .hero__dates-div { display: none; }
  }
</style>
