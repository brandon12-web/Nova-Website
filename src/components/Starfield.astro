---
// Subtle animated starfield for the hero backdrop.
// Progressive enhancement: renders nothing heavy until JS runs,
// and stays static for users who prefer reduced motion.
---

<canvas class="starfield" aria-hidden="true"></canvas>

<style>
  .starfield {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.querySelector(".starfield") as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext("2d");
    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let stars: { x: number; y: number; r: number; a: number; tw: number; vx: number; vy: number }[] = [];
    let raf = 0;
    let w = 0, h = 0;

    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    function seed() {
      const rect = canvas!.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas!.width = Math.floor(w * dpr);
      canvas!.height = Math.floor(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      // density scales with area, capped for performance
      const count = Math.min(140, Math.floor((w * h) / 9000));
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() * 1.4 + 0.3,
        a: Math.random() * 0.6 + 0.2,
        tw: Math.random() * 0.02 + 0.004,
        vx: (Math.random() - 0.5) * 0.06,
        vy: (Math.random() - 0.5) * 0.06,
      }));
    }

    function drawStatic() {
      ctx!.clearRect(0, 0, w, h);
      for (const s of stars) {
        ctx!.globalAlpha = s.a;
        ctx!.fillStyle = Math.random() > 0.85 ? "#3d8bbd" : "#ffffff";
        ctx!.beginPath();
        ctx!.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx!.fill();
      }
      ctx!.globalAlpha = 1;
    }

    let phase = 0;
    function animate() {
      ctx!.clearRect(0, 0, w, h);
      phase += 0.02;
      for (const s of stars) {
        s.x += s.vx;
        s.y += s.vy;
        if (s.x < 0) s.x = w; else if (s.x > w) s.x = 0;
        if (s.y < 0) s.y = h; else if (s.y > h) s.y = 0;
        const twinkle = s.a + Math.sin(phase + s.x) * 0.18;
        ctx!.globalAlpha = Math.max(0.05, Math.min(0.85, twinkle));
        ctx!.fillStyle = s.r > 1.1 ? "#3d8bbd" : "#ffffff";
        ctx!.beginPath();
        ctx!.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx!.fill();
      }
      ctx!.globalAlpha = 1;
      raf = requestAnimationFrame(animate);
    }

    function start() {
      cancelAnimationFrame(raf);
      seed();
      if (prefersReduced) drawStatic();
      else animate();
    }

    // Pause when the hero scrolls out of view to save battery
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (prefersReduced) return;
        if (e.isIntersecting) { if (!raf) animate(); }
        else { cancelAnimationFrame(raf); raf = 0; }
      }
    });
    io.observe(canvas);

    let resizeTimer: number;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(start, 150);
    });

    start();
  }
</script>
