---
// The Jotform embed goes inside the container below.
// Paste your iframe embed code where the placeholder comment sits.
---

<section class="section apply" id="apply" aria-labelledby="apply-title">
  <div class="container">
    <div class="apply__head reveal">
      <span class="section__eyebrow">Your shot starts here</span>
      <h2 class="section__title" id="apply-title">Apply to Nova</h2>
      <p class="section__lead">
        Ready to test yourself? Fill out the application below with your team of
        four. Applications close <strong>September 10, 2026</strong> &mdash;
        don't wait until the last minute.
      </p>
    </div>

    <div class="apply__form-wrap reveal">
      <!-- JOTFORM EMBED: paste Jotform iframe embed code here -->

      <!-- Placeholder shown until the embed is added. Delete this block
           once your Jotform iframe is pasted above. -->
      <div class="apply__placeholder" role="note">
        <span class="apply__placeholder-icon" aria-hidden="true">✦</span>
        <p class="apply__placeholder-title">Application form loads here</p>
        <p class="apply__placeholder-text">
          Paste your Jotform embed code into <code>src/components/Apply.astro</code>,
          replacing the marked comment. The form will inherit this dark container styling.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .apply {
    background:
      radial-gradient(90% 60% at 50% 0%, rgba(43, 110, 150, 0.14), transparent 60%),
      var(--bg);
  }
  .apply__head {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .apply__head .section__lead { margin-inline: auto; }

  .apply__form-wrap {
    max-width: 820px;
    margin-inline: auto;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(1.25rem, 4vw, 2rem);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
  }
  /* make any embedded Jotform iframe responsive & full-width */
  .apply__form-wrap :global(iframe) {
    width: 100% !important;
    min-width: 100% !important;
    border: 0;
    border-radius: var(--radius-sm);
    color-scheme: dark;
  }

  .apply__placeholder {
    text-align: center;
    padding: clamp(2rem, 7vw, 4rem) 1.5rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.015);
  }
  .apply__placeholder-icon { font-size: 2rem; color: var(--steel-bright); }
  .apply__placeholder-title {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.25rem;
    color: #fff;
    margin: 0.75rem 0 0.4rem;
  }
  .apply__placeholder-text {
    color: var(--muted);
    max-width: 46ch;
    margin: 0 auto;
    font-size: 0.95rem;
  }
  .apply__placeholder code {
    background: rgba(255, 255, 255, 0.06);
    padding: 0.1em 0.4em;
    border-radius: 5px;
    font-size: 0.9em;
    color: #e0e0e6;
  }
</style>
